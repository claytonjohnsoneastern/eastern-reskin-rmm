+++ b/src/css/eastern.sass
@@ -0,0 +1,434 @@
+// Eastern Telephone & Technologies — theme layer for the RMM console (modern draft).
+// Presentation only: no rule here hides, moves or disables a control, so every
+// menu, tab and dialog stays where Tactical's documentation says it is.
+
+// ---- Tokens ---------------------------------------------------------------
+:root
+  --et-ink: #1D252B
+  --et-orange: #EB5937
+  --et-canvas: #F3F5F7
+  --et-surface: #FFFFFF
+  --et-surface-2: #F7F9FA
+  --et-hover: #EEF2F5
+  --et-line: #E1E6EA
+  --et-line-strong: #CBD3D9
+  --et-text: #1D252B
+  --et-muted: #5E6B75
+  --et-selected: #E3EFF9
+  --et-shadow: 0 10px 28px rgba(16, 24, 31, 0.12), 0 2px 6px rgba(16, 24, 31, 0.06)
+
+body.body--dark
+  --q-primary: #55A6E6
+  --et-canvas: #0E1317
+  --et-surface: #161D22
+  --et-surface-2: #1B242A
+  --et-hover: #212B32
+  --et-line: #26313A
+  --et-line-strong: #34424D
+  --et-text: #E6EBEF
+  --et-muted: #93A1AC
+  --et-selected: #173450
+  --et-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3)
+
+body
+  background: var(--et-canvas)
+  color: var(--et-text)
+
+body a
+  color: var(--q-primary)
+
+// On dark surfaces the brighter blue carries ink-coloured text and ticks, which
+// keeps both the blue-on-dark and the label-on-blue pairs above 4.5:1.
+body.body--dark .bg-primary.text-white
+  color: #0B1116 !important
+
+body.body--dark .q-checkbox__inner--truthy .q-checkbox__svg
+  color: #0B1116
+
+// ---- Logo lockup ------------------------------------------------------------
+// Live-text rendering of the Eastern wordmark: heavy "Eastern", thick rule over a
+// thin rule, then the company line. em-based so it scales from font-size.
+.et-logo
+  display: inline-flex
+  flex-direction: column
+  align-items: stretch
+  vertical-align: middle
+  color: inherit
+  font-family: "Heebo", Arial, sans-serif
+  line-height: 1
+  white-space: nowrap
+  user-select: none
+
+.et-logo__word
+  font-size: 1em
+  font-weight: 900
+  letter-spacing: -0.005em
+  line-height: 0.8
+  padding-bottom: 0.07em
+
+.et-logo__rules
+  display: block
+  height: 0.16em
+  border-top: 0.085em solid currentColor
+  border-bottom: 0.03em solid currentColor
+
+.et-logo__sub
+  font-size: 0.262em
+  font-weight: 500
+  line-height: 1
+  padding-top: 0.22em
+  text-align: justify
+  text-align-last: justify
+
+.et-logo--compact .et-logo__sub
+  display: none
+
+// ---- App bar: header + the File/View/Agents menu read as one surface ---------
+.et-header
+  background: var(--et-surface)
+  color: var(--et-text)
+  box-shadow: none
+
+  .q-toolbar
+    min-height: 48px
+
+  .q-toolbar__title
+    display: flex
+    align-items: center
+    gap: 12px
+    font-size: 16px
+
+  .et-logo
+    font-size: 25px
+
+  .et-product
+    font-size: 14px
+    font-weight: 700
+    padding-left: 12px
+    border-left: 1px solid var(--et-line-strong)
+    line-height: 22px
+
+  .text-overline
+    font-size: 12px
+    letter-spacing: 0
+    line-height: 1
+    font-weight: 500
+    color: var(--et-muted)
+    font-variant-numeric: tabular-nums
+
+  .q-btn
+    border-radius: 8px
+
+  .q-chip
+    background: var(--et-hover)
+    color: var(--et-text)
+
+.q-page > .q-pb-sm
+  padding-bottom: 8px
+
+.q-page > .q-pb-sm > .q-bar
+  background: var(--et-surface)
+  color: var(--et-text)
+  border-bottom: 1px solid var(--et-line)
+  height: 32px
+  padding: 0 10px
+
+  .q-btn
+    padding: 0 10px
+    border-radius: 6px
+    font-weight: 500
+    font-size: 14px
+
+  .q-btn:hover .q-focus-helper
+    background: currentColor
+    opacity: 0.08
+
+// ---- Dashboard: tree and tables sit on the canvas as two framed panels -------
+.q-page > .q-pb-sm + .q-splitter
+  padding: 0 8px 8px
+
+  > .q-splitter__before,
+  > .q-splitter__after
+    background: var(--et-surface)
+    border: 1px solid var(--et-line)
+    border-radius: 10px
+
+  > .q-splitter__separator
+    width: 8px
+    background: transparent
+
+  > .q-splitter__after
+    border: 0
+    background: transparent
+    overflow: hidden
+
+  > .q-splitter__after > .q-splitter--horizontal
+    height: 100%
+
+    > .q-splitter__before,
+    > .q-splitter__after
+      background: var(--et-surface)
+      border: 1px solid var(--et-line)
+      border-radius: 10px
+      overflow: hidden
+
+    > .q-splitter__separator
+      height: 8px
+      background: transparent
+
+    // The framing above costs 17px of height that Tactical's table-height maths
+    // does not know about; win it back from the toolbar row and the row counter
+    // so the agent table never clips.
+    > .q-splitter__before
+      > .row > .q-field
+        padding-bottom: 0
+      > .row .q-field--dense .q-field__control,
+      > .row .q-field--dense .q-field__marginal
+        height: 36px
+        min-height: 36px
+      > .row .q-field--dense .q-field__native
+        min-height: 36px
+        padding: 0
+      .q-table__bottom
+        min-height: 23px
+        height: 23px
+        padding-top: 0
+        padding-bottom: 0
+        font-size: 12px
+
+// client tree
+.q-tree__node-header
+  border-radius: 6px
+  padding: 3px 6px
+
+.q-tree__node--selected
+  background: var(--et-selected)
+
+.q-page .q-list .q-item.q-router-link--active,
+.q-page .q-list .q-item--active
+  border-radius: 6px
+  background: var(--et-selected)
+
+// ---- Tables ---------------------------------------------------------------
+.q-table
+  font-variant-numeric: tabular-nums
+
+.q-table th
+  font-weight: 600
+  font-size: 12.5px
+  color: var(--et-muted)
+
+.q-table thead tr, .q-table tbody td, .q-table tr th
+  border-color: var(--et-line)
+
+body .table-bgcolor,
+body .table-bgcolor-dark
+  .q-table__top,
+  .q-table__bottom,
+  thead tr:first-child th
+    background-color: var(--et-surface-2)
+
+.q-table__card
+  background: var(--et-surface)
+  box-shadow: none
+
+body .highlight,
+body .highlight-dark
+  background-color: var(--et-selected)
+
+  > td:first-child
+    box-shadow: inset 3px 0 0 var(--q-primary)
+
+.q-table tbody tr:not(.highlight):not(.highlight-dark):hover > td
+  background: var(--et-hover)
+
+// ---- Tabs, buttons, fields, chips -----------------------------------------
+.q-tab
+  text-transform: none
+
+.q-tab__indicator
+  height: 2px
+  border-radius: 2px 2px 0 0
+
+.q-btn
+  text-transform: none
+  letter-spacing: 0
+  font-weight: 500
+
+.q-btn--round,
+.q-btn--rounded
+  border-radius: 50%
+
+.q-field--outlined .q-field__control
+  border-radius: 6px
+
+.q-field--outlined .q-field__control:before
+  border-color: var(--et-line-strong)
+
+.q-field--filled .q-field__control
+  border-radius: 6px 6px 0 0
+
+.q-chip
+  border-radius: 999px
+
+.q-badge
+  border-radius: 999px
+  padding: 2px 7px
+
+// ---- Floating layers ------------------------------------------------------
+.q-menu
+  border-radius: 8px
+  box-shadow: var(--et-shadow), 0 0 0 1px var(--et-line)
+  background: var(--et-surface)
+
+.q-menu .q-item
+  border-radius: 6px
+  margin: 1px 4px
+
+.q-menu .q-list
+  padding: 4px 0
+
+.q-tooltip
+  background: var(--et-ink)
+  color: #fff
+  border-radius: 6px
+  font-size: 12px
+
+.q-notification
+  border-radius: 8px
+
+.q-dialog__inner > .q-card,
+.q-dialog__inner > div > .q-card
+  border-radius: 12px
+  box-shadow: var(--et-shadow)
+
+.q-dialog__inner--maximized > .q-card,
+.q-dialog__inner--maximized > div > .q-card
+  border-radius: 0
+
+.q-dialog .q-bar
+  background: var(--et-surface)
+  color: var(--et-text)
+  border-bottom: 1px solid var(--et-line)
+  height: 44px
+  font-size: 15px
+  font-weight: 600
+  padding: 0 12px 0 16px
+
+body.body--dark .q-dialog .q-card--dark,
+body.body--dark .q-menu
+  border: 1px solid var(--et-line)
+
+// ---- Keyboard focus and scrollbars ----------------------------------------
+.q-btn:focus-visible,
+.q-tab:focus-visible,
+.q-item:focus-visible,
+.q-tree__node-header:focus-visible,
+a:focus-visible
+  outline: 2px solid var(--q-primary)
+  outline-offset: 2px
+
+*
+  scrollbar-width: thin
+  scrollbar-color: var(--et-line-strong) transparent
+
+::-webkit-scrollbar
+  width: 10px
+  height: 10px
+
+::-webkit-scrollbar-thumb
+  background: var(--et-line-strong)
+  border-radius: 10px
+  border: 2px solid transparent
+  background-clip: content-box
+
+::-webkit-scrollbar-track
+  background: transparent
+
+@media (prefers-reduced-motion: reduce)
+  *, *::before, *::after
+    transition-duration: 0.01ms !important
+    animation-duration: 0.01ms !important
+
+// ---- Sign-in ----------------------------------------------------------------
+.et-login
+  background: #0E1317
+
+.et-login-shell
+  display: grid
+  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr)
+  min-height: 100vh
+  width: 100%
+
+.et-login-brand
+  position: relative
+  background: #161D22
+  color: #fff
+  padding: 56px 56px 40px
+  display: flex
+  flex-direction: column
+  border-right: 1px solid #26313A
+
+  .et-logo
+    font-size: 72px
+    align-self: flex-start
+
+.et-login-tag
+  margin: 22px 0 0
+  font-size: 18px
+  font-weight: 500
+  color: #C9D2D9
+
+.et-login-legal
+  margin-top: auto
+  font-size: 11.5px
+  line-height: 1.55
+  color: #7F8E99
+
+  a
+    color: inherit
+
+.et-login-main
+  display: flex
+  align-items: center
+  justify-content: center
+  padding: 40px 24px
+
+.et-login-card
+  width: 100%
+  max-width: 400px
+  background: transparent
+  box-shadow: none
+
+.et-login-title
+  margin: 0
+  font-size: 26px
+  font-weight: 700
+  line-height: 1.2
+
+.et-login-hint
+  margin: 8px 0 0
+  color: #93A1AC
+  font-size: 14px
+
+.et-login-card .q-btn
+  height: 44px
+  font-size: 15px
+
+@media (max-width: 900px)
+  .et-login-shell
+    grid-template-columns: 1fr
+  .et-login-brand
+    padding: 32px 24px
+    border-right: 0
+    border-bottom: 1px solid #26313A
+    .et-logo
+      font-size: 52px
+  .et-login-legal
+    margin-top: 20px
+
+// ---- Session expired / not found --------------------------------------------
+.et-standalone
+  .et-logo
+    font-size: 56px
+    margin-bottom: 28px
