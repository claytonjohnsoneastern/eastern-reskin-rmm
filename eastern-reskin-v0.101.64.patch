--- /dev/null
+++ b/src/css/eastern.sass
@@ -0,0 +1,175 @@
+// Eastern Telephone & Technologies — theme layer for the RMM console.
+// Presentation only. No selectors here hide, move or disable any control.
+
+:root
+  --et-ink: #1D252B
+  --et-ink-deep: #141A1F
+  --et-ink-raised: #26313A
+  --et-line-dark: #34424D
+  --et-orange: #EB5937
+  --et-blue: #056EB9
+  --et-mist: #EFF2F5
+  --et-line: #D5DBE1
+  --et-row-selected: #D9ECFA
+  --et-row-selected-dark: #24405A
+
+// Primary needs to be a little brighter to stay readable on the dark surfaces.
+body.body--dark
+  --q-primary: #2586D3
+
+body a
+  color: var(--q-primary)
+
+// ---- Logo lockup -----------------------------------------------------------
+// A live-text rendering of the Eastern wordmark: heavy "Eastern", a thick rule
+// over a thin rule, then the company line. em-based so it scales from font-size.
+.et-logo
+  display: inline-flex
+  flex-direction: column
+  align-items: stretch
+  vertical-align: middle
+  color: inherit
+  font-family: "Heebo", Arial, sans-serif
+  line-height: 1
+  white-space: nowrap
+  user-select: none
+
+.et-logo__word
+  font-size: 1em
+  font-weight: 900
+  letter-spacing: -0.005em
+  line-height: 0.8
+  padding-bottom: 0.07em
+
+.et-logo__rules
+  display: block
+  height: 0.16em
+  border-top: 0.085em solid currentColor
+  border-bottom: 0.03em solid currentColor
+
+.et-logo__sub
+  font-size: 0.262em
+  font-weight: 500
+  letter-spacing: 0
+  line-height: 1
+  padding-top: 0.22em
+  text-align: justify
+  text-align-last: justify
+
+.et-logo--compact .et-logo__sub
+  display: none
+
+// ---- App header ------------------------------------------------------------
+.et-header
+  background: var(--et-ink)
+
+  .q-toolbar
+    // The logo's thick-over-thin rule, in the brand orange, closes the header.
+    box-shadow: inset 0 -1px 0 0 var(--et-orange), inset 0 -2px 0 0 var(--et-ink), inset 0 -5px 0 0 var(--et-orange)
+    padding-bottom: 5px
+
+  .q-toolbar__title
+    display: flex
+    align-items: center
+    gap: 10px
+
+  .et-logo
+    font-size: 27px
+
+  .et-product
+    font-size: 15px
+    font-weight: 500
+    letter-spacing: 0.01em
+    padding-left: 12px
+    margin-left: 4px
+    border-left: 1px solid rgba(255, 255, 255, 0.28)
+    line-height: 26px
+
+// ---- Menu bar under the header --------------------------------------------
+.q-page > .q-pb-sm > .q-bar
+  background: var(--et-mist)
+  border-bottom: 1px solid var(--et-line)
+
+body.body--dark .q-page > .q-pb-sm > .q-bar
+  background: var(--et-ink)
+  border-bottom-color: var(--et-line-dark)
+
+// ---- Dialog title bars -----------------------------------------------------
+.q-dialog .q-bar
+  background: var(--et-ink)
+  color: #ffffff
+
+body.body--dark .q-dialog .q-bar
+  background: var(--et-ink-deep)
+  border-bottom: 1px solid var(--et-line-dark)
+
+// ---- Tables ---------------------------------------------------------------
+.q-table
+  font-variant-numeric: tabular-nums
+
+.q-table th
+  font-weight: 700
+
+body .table-bgcolor
+  .q-table__top,
+  .q-table__bottom,
+  thead tr:first-child th
+    background-color: var(--et-mist)
+
+body .table-bgcolor-dark
+  .q-table__top,
+  .q-table__bottom,
+  thead tr:first-child th
+    background-color: var(--et-ink-raised)
+
+body .highlight
+  background-color: var(--et-row-selected)
+
+body .highlight-dark
+  background-color: var(--et-row-selected-dark)
+
+body.body--dark
+  .q-separator--dark,
+  .q-splitter__separator
+    background-color: var(--et-line-dark)
+
+  .q-menu,
+  .q-card--dark
+    border: 1px solid var(--et-line-dark)
+
+// ---- Sign-in, session-expired and not-found screens ------------------------
+.et-login
+  background: var(--et-ink-deep)
+
+.et-login-card
+  border-top: 3px solid var(--et-orange)
+
+  .et-logo
+    font-size: 76px
+
+.et-login-product
+  margin-top: 18px
+  font-size: 15px
+  font-weight: 500
+  opacity: 0.75
+
+.et-legal
+  position: absolute
+  left: 0
+  right: 0
+  bottom: 14px
+  text-align: center
+  font-size: 11px
+  line-height: 1.5
+  color: rgba(255, 255, 255, 0.45)
+
+  a
+    color: inherit
+
+.et-standalone .et-logo
+  font-size: 56px
+  margin-bottom: 28px
+
+@media (max-width: 599px)
+  .et-login-card .et-logo
+    font-size: 56px
